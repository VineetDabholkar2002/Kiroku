# =================================================================
# KIROKU ECOSYSTEM DOCKER ENVIRONMENT CONFIGURATION
# =================================================================

# -----------------------------------------------------------------
# Chatbot AI Providers (Optional - Auto fallback chain active)
# -----------------------------------------------------------------
CHAT_PROVIDER=auto

# Google Gemini API (Get free key at: https://aistudio.google.com/)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Groq Cloud API (Get free key at: https://console.groq.com/)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Local Ollama Host (When running Ollama natively on Windows host)
OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_MODEL=dolphin-mistral
