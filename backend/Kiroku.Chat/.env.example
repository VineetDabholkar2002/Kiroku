# =================================================================
# KIROKU CHAT SERVICE CONFIGURATION
# =================================================================

# Provider Mode:
#   auto   - Try Gemini first -> Groq second -> Ollama third -> Fallback (Recommended)
#   gemini - Use Google Gemini API only
#   groq   - Use Groq Cloud API only
#   ollama - Use local Ollama instance only
CHAT_PROVIDER=auto

# -----------------------------------------------------------------
# 1. Google Gemini API (Recommended - Fast & Free Tier)
# Get your free key at: https://aistudio.google.com/
# -----------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# -----------------------------------------------------------------
# 2. Groq Cloud API (Ultra-fast Llama 3 / Mixtral inference)
# Get your free key at: https://console.groq.com/
# -----------------------------------------------------------------
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# -----------------------------------------------------------------
# 3. Local Ollama (Self-hosted fallback)
# Download from: https://ollama.com/
# -----------------------------------------------------------------
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=dolphin-mistral
